POSTGRES_USER=saga
POSTGRES_PASSWORD=saga-local-only
ORDER_DATABASE_URL=postgresql+asyncpg://saga:saga-local-only@postgres:5432/orders
PAYMENT_DATABASE_URL=postgresql+asyncpg://saga:saga-local-only@postgres:5432/payments
INVENTORY_DATABASE_URL=postgresql+asyncpg://saga:saga-local-only@postgres:5432/inventory
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
PAYMENT_COMMANDS_TOPIC=payments.commands.v1
PAYMENT_EVENTS_TOPIC=payments.events.v1
INVENTORY_COMMANDS_TOPIC=inventory.commands.v1
INVENTORY_EVENTS_TOPIC=inventory.events.v1
DLQ_TOPIC=saga.dlq.v1
MESSAGE_RETRY_ATTEMPTS=3
MESSAGE_BACKOFF_SECONDS=1,2,4
OUTBOX_POLL_SECONDS=0.5
OUTBOX_BATCH_SIZE=100
LOG_LEVEL=INFO
